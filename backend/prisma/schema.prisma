generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Country {
  name         String               @unique
  ruName       String               @unique @map("ru_name")
  countryCode  String               @unique @map("country_code")
  bgImage      String?              @map("bg_image")
  createdAt    DateTime?            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?            @default(now()) @map("updated_at") @db.Timestamp(6)
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description  String?
  information  CountryInformation?
  requirements CountryRequirements?
  universities University[]
  reviews      Review[]

  @@map("country")
}

model Currency {
  name               String               @db.VarChar(55)
  code               String               @unique @db.VarChar(3)
  symbol             String               @db.VarChar(1)
  id                 Int                  @id @default(autoincrement())
  countryInformation CountryInformation[]

  @@map("currency")
}

model CountryInformation {
  languages  String[]  @db.VarChar
  capital    String?   @db.VarChar(255)
  population Int?
  currencyId Int?      @map("currency_id")
  countryId  String    @id @map("country_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_currency")
  country    Country   @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "general_country_information_country_id_fkey")

  @@map("country_information")
}

model CountryRequirements {
  minimalStudentVisaAge Int?     @map("minimal_student_visa_age")
  educationRequirements String?  @map("education_requirements") @db.VarChar
  nostrification        Boolean?
  financialGuarantees   Int?     @map("financial_guarantees")
  countryId             String   @id @map("country_id") @db.Uuid
  country               Country  @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "general_country_requirements_country_id_fkey")

  @@map("country_requirements")
}

model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String         @unique @db.VarChar(50)
  email        String         @unique @db.VarChar(255)
  password     String         @db.VarChar(255)
  avatarUrl    String?        @map("avatar_url") @db.VarChar(255)
  isActivated  Boolean        @default(false) @map("is_activated")
  createdAt    DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?      @default(now()) @map("updated_at") @db.Timestamp(6)
  refreshToken String?        @map("refresh_token")
  status       UserStatusEnum @default(ACTIVE)
  reviews      Review[]
  tickets      Ticket[]
  universities University[]
  roleId       Int            @map("role_id")

  role Role @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Ticket {
  id           Int              @id(map: "edit_requests_pkey") @default(autoincrement()) @map("id")
  statusId     Int              @map("status_id")
  userId       String           @map("user_id") @db.Uuid
  createdAt    DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?        @map("updated_at") @db.Timestamp(6)
  entityType   EntityTypeEnum   @map("entity_type")
  entityId     String?          @map("entity_id") @db.Uuid
  reviewedBy   String?          @map("reviewed_by") @db.Uuid
  payload      Json?
  entityAction EntityActionEnum @map("entity_action")
  status       TicketStatus     @relation(fields: [statusId], references: [status_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_status_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_id")

  @@map("tickets")
}

model TicketStatus {
  status_id  Int      @id @default(autoincrement())
  statusName String?  @unique @map("status_name") @db.VarChar(20)
  tickets    Ticket[]

  @@map("tickets_statuses")
}

model FieldOfStudy {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String?           @db.VarChar(150)
  universityFields UniversityField[]

  @@map("fields_of_study")
}

model ProgramOfStudy {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String?             @db.VarChar(150)
  universityPrograms UniversityProgram[]

  @@map("programs_of_study")
}

model University {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?                 @db.VarChar(100)
  description  String?
  bgImage      String?                 @map("bg_image") @db.VarChar(50)
  createdAt    DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?               @map("updated_at") @db.Timestamp(6)
  createdBy    String?                 @map("created_by") @db.Uuid
  countryId    String?                 @map("country_id") @db.Uuid
  country      Country?                @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_country_id")
  creator      User?                   @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  information  UniversityInformation?
  requirements UniversityRequirements?
  fields       UniversityField[]
  reviews      Review[]

  @@map("universities")
}

model UniversityInformation {
  universityId     String     @id @map("university_id") @db.Uuid
  top              Int?
  city             String?    @db.VarChar(255)
  students         Int?
  yearOfFoundation Int?       @map("year_of_foundation") @db.SmallInt
  university       University @relation(fields: [universityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("universities_information")
}

model UniversityRequirements {
  universityId  String     @id @map("university_id") @db.Uuid
  languageLevel String?    @map("language_level") @db.VarChar(4)
  documents     String[]   @db.VarChar(255)
  deadline      DateTime?  @db.Date
  university    University @relation(fields: [universityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("universities_requirements")
}

model UniversityField {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String?             @map("university_id") @db.Uuid
  fieldId      String?             @map("field_id") @db.Uuid
  name         String?             @db.VarChar(150)
  field        FieldOfStudy?       @relation(fields: [fieldId], references: [id], onUpdate: NoAction, map: "fk_field_id")
  university   University?         @relation(fields: [universityId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_university_id")
  programs     UniversityProgram[]

  @@map("university_fields")
}

model UniversityProgram {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityFieldId String?          @map("university_fields_id") @db.Uuid
  name              String?          @db.VarChar(150)
  description       String?
  programOfStudyId  String?          @map("program_of_study_id") @db.Uuid
  programOfStudy    ProgramOfStudy?  @relation(fields: [programOfStudyId], references: [id], onUpdate: NoAction, map: "fk_program_of_study_id")
  universityField   UniversityField? @relation(fields: [universityFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("university_programs")
}

model Review {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  text         String?
  type         ReviewEnum
  likes        Int?
  dislikes     Int?
  countryId    String      @map("country_id") @db.Uuid
  universityId String?     @map("university_id") @db.Uuid
  user         User?       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  country      Country     @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("reviews")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  users User[]

  @@map("roles")
}

model VerificationCode {
  id             Int                  @id() @default(autoincrement())
  code           String
  email          String               @unique
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  expirationTime DateTime             @map("expiration_time") @db.Timestamp(6)
  isActivated    Boolean              @default(false) @map("is_activated")
  type           VerificationCodeEnum

  @@map("verification_codes")
}

enum UserStatusEnum {
  ACTIVE
  BLOCK
  DELETE
}

enum EntityTypeEnum {
  COUNTRY
  UNIVERSITY
  PROGRAM
}

enum EntityActionEnum {
  CREATE
  UPDATE
  DELETE
}

enum VerificationCodeEnum {
  REGISTRATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum ReviewEnum {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

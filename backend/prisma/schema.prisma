generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  countryCode String @map("country_code")
  bgImage     String @map("bg_image")

  description String?

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  information  CountryInformation?
  requirements CountryRequirements?
  reviews      CountryReview[]
  universities University[]

  @@map("country")
}

model Currency {
  id     Int     @id @default(autoincrement())
  name   String? @db.VarChar(255)
  symbol String? @db.VarChar(255)

  countryInformation CountryInformation[]

  @@map("currency")
}

model CountryInformation {
  countryId  String   @id @map("country_id") @db.Uuid
  languages  String[] @db.VarChar
  capital    String?  @db.VarChar(255)
  population Int?

  currencyId Int? @map("currency_id")

  currency Currency? @relation(fields: [currencyId], references: [id], map: "fk_currency")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade, map: "general_country_information_country_id_fkey")

  @@map("country_information")
}

model CountryRequirements {
  countryId String @id @map("country_id") @db.Uuid

  minimalStudentVisaAge Int?     @map("minimal_student_visa_age")
  educationRequirements String?  @map("education_requirements") @db.VarChar
  nostrification        Boolean?
  financialGuarantees   Int?     @map("financial_guarantees")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade, map: "general_country_requirements_country_id_fkey")

  @@map("country_requirements")
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @unique @db.VarChar(50)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  avatarUrl   String? @map("avatar_url") @db.VarChar(255)
  isActivated Boolean @default(false) @map("is_activated")

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  reviews      Review[]
  tickets      Ticket[]
  universities University[]

  @@map("users")
}

model Ticket {
  id       Int    @id @default(autoincrement()) @map("id")
  statusId Int    @map("status_id")
  userId   String @map("user_id") @db.Uuid

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  entityType String  @map("entity_type") @db.VarChar(255)
  entityId   String? @map("entity_id") @db.Uuid
  reviewedBy String? @map("reviewed_by") @db.Uuid
  payload    Json?

  status TicketStatus @relation(fields: [statusId], references: [status_id], map: "fk_status_id")
  user   User         @relation(fields: [userId], references: [id], map: "fk_user_id")

  @@map("tickets")
}

model TicketStatus {
  status_id  Int     @id @default(autoincrement())
  statusName String? @map("status_name") @db.VarChar(20)

  tickets Ticket[]

  @@map("tickets_statuses")
}

model FieldOfStudy {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String? @db.VarChar(150)

  universityFields UniversityField[]

  @@map("fields_of_study")
}

model ProgramOfStudy {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String? @db.VarChar(150)

  universityPrograms UniversityProgram[]

  @@map("programs_of_study")
}

model University {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String? @db.VarChar(100)
  description String?

  bgImage String? @map("bg_image") @db.VarChar(50)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  createdBy String? @map("created_by") @db.Uuid
  countryId String? @map("country_id") @db.Uuid

  country Country? @relation(fields: [countryId], references: [id], map: "fk_country_id")
  creator User?    @relation(fields: [createdBy], references: [id])

  information  UniversityInformation?
  requirements UniversityRequirements?
  reviews      UniversityReview[]
  fields       UniversityField[]

  @@map("universities")
}

model UniversityInformation {
  universityId     String  @id @map("university_id") @db.Uuid
  top              Int?
  city             String? @db.VarChar(255)
  students         Int?
  yearOfFoundation Int?    @map("year_of_foundation") @db.SmallInt

  university University @relation(fields: [universityId], references: [id])

  @@map("universities_information")
}

model UniversityRequirements {
  universityId  String    @id @map("university_id") @db.Uuid
  languageLevel String?   @map("language_level") @db.VarChar(4)
  documents     String[]  @db.VarChar(255)
  deadline      DateTime? @db.Date

  university University @relation(fields: [universityId], references: [id])

  @@map("universities_requirements")
}

model UniversityField {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String? @map("university_id") @db.Uuid
  fieldId      String? @map("field_id") @db.Uuid
  name         String? @db.VarChar(150)

  field      FieldOfStudy?       @relation(fields: [fieldId], references: [id], map: "fk_field_id")
  university University?         @relation(fields: [universityId], references: [id], map: "fk_university_id")
  programs   UniversityProgram[]

  @@map("university_fields")
}

model UniversityProgram {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityFieldId String? @map("university_fields_id") @db.Uuid
  name              String? @db.VarChar(150)
  description       String?
  programOfStudyId  String? @map("program_of_study_id") @db.Uuid

  programOfStudy  ProgramOfStudy?  @relation(fields: [programOfStudyId], references: [id], map: "fk_program_of_study_id")
  universityField UniversityField? @relation(fields: [universityFieldId], references: [id])

  @@map("university_programs")
}

model CountryReview {
  countryId String @map("country_id") @db.Uuid
  reviewId  String @map("review_id") @db.Uuid

  country Country @relation(fields: [countryId], references: [id])
  review  Review  @relation(fields: [reviewId], references: [id])

  @@id([countryId, reviewId])
  @@map("country_review")
}

model Review {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  content       String?
  isRecommended Boolean? @map("is_recommended")
  recommended   Int?
  unrecommended Int?

  user         User?              @relation(fields: [userId], references: [id])
  countries    CountryReview[]
  universities UniversityReview[]

  @@map("reviews")
}

model UniversityReview {
  universityId String @map("university_id") @db.Uuid
  reviewId     String @map("review_id") @db.Uuid

  university University @relation(fields: [universityId], references: [id])
  review     Review     @relation(fields: [reviewId], references: [id])

  @@id([universityId, reviewId])
  @@map("universities_review")
}
